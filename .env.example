# ==================== 大模型接入配置 ====================
# 复制本文件为 .env，填入你自己的 Key 后重启后端。
# 换模型 / 换供应商只需要改这里的几项，代码不用动。

# --- 火山方舟（默认）---
# 方舟同时提供豆包、DeepSeek、智谱等模型，base_url 相同，只改 LLM_MODEL 即可
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=your_api_key_here
# 接入点 ID（ep-xxxxx）。部分模型支持直接填模型 ID 调用
LLM_MODEL=ep-xxxxxxxxxxxxxxxx

# --- 换成其他供应商时，取消注释并替换（以 DeepSeek 官方为例）---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=deepseek-chat

# --- 兼容旧变量名：LLM_* 没配置时自动回退到 ARK_* ---
# ARK_API_KEY=your_ark_api_key_here
# ARK_MODEL=ep-xxxxxxxxxxxxxxxx

# --- 可选：给"检索重排"单独指定一个更轻量的模型（降本提速）---
# 不填则与 LLM_MODEL 一致
# RERANK_MODEL=deepseek-v4-1-flash

# --- 可选：关闭思考链的请求参数（各厂商字段名不同）---
#   火山方舟 / 智谱：{"thinking": {"type": "disabled"}}
#   通义千问        ：{"enable_thinking": false}
#   留空表示不发送。若厂商不接受该参数，程序会自动去掉后重试一次。
# LLM_DISABLE_THINKING_JSON={"thinking": {"type": "disabled"}}

# --- 其他可选配置（不填就走代码默认值）---
# MAX_UPLOAD_MB=200
# DF_CACHE_SIZE=3
